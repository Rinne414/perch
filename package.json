{
  "name": "perch",
  "productName": "Perch",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop reminder for people who run AI agents: capture fast, see what needs you now, and look back at what got done.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "icon": "node scripts/make-icon.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "chrono-node": "2.10.1"
  },
  "author": "Rinne414",
  "license": "GPL-3.0-or-later"
}
